<?xml version="1.0" encoding="utf-8"?>
<!--
  LocalFit AI 的全数据本地约束（ADR + docs/08）不允许把库内容交给平台云备份：
  Android 12+（API 31+）的自动备份/换机迁移规则在这里逐域排除。
  <application android:allowBackup="false"> 已经关掉整条通道，本文件是第二道
  防线——防止未来有人把 allowBackup 打开后静默恢复云备份。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="device_root" />
        <exclude domain="device_file" />
        <exclude domain="device_database" />
        <exclude domain="device_sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="device_root" />
        <exclude domain="device_file" />
        <exclude domain="device_database" />
        <exclude domain="device_sharedpref" />
    </device-transfer>
</data-extraction-rules>
